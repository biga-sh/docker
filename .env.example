# Written by ./scripts/setup.sh; edit by hand if you prefer. Keep this file
# private (chmod 600): it holds the database password and access keys.

# --- Address ---------------------------------------------------------------
# public:   a domain that resolves to this machine; HTTPS from Let's Encrypt.
# internal: a private name or IP (biga.lan, 10.0.0.5, [fd00::5]); HTTPS from
#           Caddy's own CA, which each device trusts once (scripts/trust-ca.sh).
# http:     plain HTTP; only for a network you fully trust, or when something
#           in front of this terminates TLS.
BIGA_PROXY_MODE=public
# What people type: a domain name, or an IP address in internal mode.
BIGA_DOMAIN=biga.example.com
# The link viewers open; the CLI uses it as BIGA_API_URL too.
BIGA_PUBLIC_URL=https://biga.example.com

# --- Listening -------------------------------------------------------------
# Empty: every interface, IPv4 and IPv6. One address: only that network,
# e.g. 192.168.1.20, or [fd00::20] for IPv6.
BIGA_BIND_ADDRESS=
BIGA_HTTP_PORT=80
BIGA_HTTPS_PORT=443
# Proxies in front of Caddy whose X-Forwarded-For to believe (CIDRs, space
# separated), e.g. Cloudflare's ranges. Leave as is when Caddy faces clients.
BIGA_UPSTREAM_PROXIES=127.0.0.1/32

# --- Secrets ---------------------------------------------------------------
POSTGRES_PASSWORD=change-me
# Comma-separated. When set, only people holding a key can broadcast; give
# them one and they run: BIGA_ACCESS_KEY=<key> biga start. Viewers never need
# one. Generate more with: docker compose run --rm --no-deps server gen-key
BIGA_ACCESS_KEYS=
# Only for compose.scale.yaml.
VALKEY_PASSWORD=change-me

# --- Server ----------------------------------------------------------------
BIGA_RETENTION_DAYS=30
# Viewer requests per client per minute. On an office network where many
# people share one public IP, raise it, or 0 to turn it off.
BIGA_READ_RATE_LIMIT=3000
BIGA_LOG_LEVEL=info
# A session the landing page embeds and retention never deletes.
BIGA_DEMO_SESSION_ID=

# --- Images ----------------------------------------------------------------
# By default both images are built from source on the first `up`. Point these
# at local checkouts to build your own changes:
# BIGA_SERVER_SOURCE=../server
# BIGA_WEB_SOURCE=../website
# Or use published images instead of building:
# BIGA_SERVER_IMAGE=ghcr.io/biga-sh/server:1
# BIGA_WEB_IMAGE=ghcr.io/biga-sh/web:1
# BIGA_PULL_POLICY=missing
